<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.2.3</Version>
    <Author>kaldigo</Author>
    <Name>Hotbar Bridge</Name>
    <Punchline>Inspect regular and cross hotbars for slot-based synchronization.</Punchline>
    <Description>Configurable two-way regular/cross hotbar synchronization with shared slots, backups and capture.</Description>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup><Compile Include="../../common/*.cs" Link="Common/%(Filename)%(Extension)" /></ItemGroup>
</Project>
